# iOS native build (Capacitor). The native Xcode project itself must be
# committed — Xcode Cloud clones fresh from git, so anything excluded here
# doesn't exist for CI even though it's sitting on local disk. Only ignore
# what `npx cap sync ios` / `pod install` regenerate every build.
ios/App/Pods/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/capacitor-cordova-ios-plugins/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/
ios/DerivedData/

# Word doc temp lock files
~$*

# Reference docs (keep local, not in repo)
*.docx

# Environment
.env
.env.*

# Audio archive (original WAVs — compressed m4a versions live in public/assets/audio/)
audio-originals/
